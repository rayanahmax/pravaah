# --- dependencies and builds ---
node_modules/
.next/
out/
build/

# --- secrets and local environment ---
# Never commit real credentials. The Supabase anon/service_role keys and the
# Postgres password live only in .env.local (and .env.*), which stay ignored.
# A scan of the full git history confirmed no secret values were ever committed;
# frontend/.env.local.example shows the expected placeholder shape.
.env
.env.*
# These re-includes only reach a root-level example file. A nested .gitignore's
# ignore cannot be undone from its parent, which is why the rule that actually
# keeps frontend/.env.local.example tracked lives in frontend/.gitignore.
!.env.local.example
!.env.example
*.pem

# --- Supabase CLI scratch (bare name matches at any depth) ---
.temp/

# --- tooling and local-only notes ---
.freebuff/
.opencode/skills/**/__pycache__/

# Session handoff notes and one-off diagnostic scripts (reference local paths).
/continue.md
/diagnose.mjs
/diagnose-*.mjs
/probe-*.mjs
/verify-*.mjs

# --- SIH portal deliverables (uploaded to the portal directly, kept out of the repo) ---
# Product/architecture docs, the AI development rulebook and the ui-ux skill are
# submitted via the SIH portal, so they are intentionally not tracked here.
/docs/
/AGENTS.md
/.opencode/

# --- OS and editor ---
.DS_Store
Thumbs.db

# --- typescript / npm noise ---
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel/
coverage/
