# Supabase — get these from https://supabase.com → Project Settings → API / Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never commit or expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — used by supabase/run-migration.js, not by the app.
# Dashboard → Project Settings → Database → "Postgres password".
# Reset it there if it is ever committed or shared; it is not rotatable from the API.
SUPABASE_DB_PASSWORD=your-postgres-password

# Optional — the AWS region of your project, as shown in its connection string
# (e.g. ap-northeast-1). The pooler hostname encodes the region, and asking the
# wrong one reports "tenant/user not found" rather than an auth failure. Leaving
# this unset makes run-migration.js search the known regions instead.
SUPABASE_POOLER_REGION=your-project-region
