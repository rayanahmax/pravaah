# Supabase — get these from https://supabase.com → Project Settings → API / Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never commit or expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — used by supabase/run-migration.js, not by the app.
# Dashboard → Project Settings → Database → "Postgres password".
# Reset it there if it is ever committed or shared; it is not rotatable from the API.
SUPABASE_DB_PASSWORD=your-postgres-password

# Optional — the AWS region of your project, as shown in its connection string
# (e.g. ap-northeast-1). The pooler hostname encodes the region, and asking the
# wrong one reports "tenant/user not found" rather than an auth failure. Leaving
# this unset makes run-migration.js search the known regions instead.
SUPABASE_POOLER_REGION=your-project-region

# Optional — weather provider (PRD §15, Phase 15).
#
# Nothing is required: Open-Meteo is the provider named in the PRD and needs no
# API key, so leaving this unset uses https://api.open-meteo.com/v1/forecast.
# Set it only to point at a different host — a local mock, or a self-hosted
# build — which is also how to exercise the provider-failure path on demand.
#
# Note that `next dev` ignores the ten-minute revalidation window (see
# services/weather.ts), so every dev render calls the provider and can consume
# its daily request cap. Point this at a mock while iterating locally.
# WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# Optional — visitor assistant language layer (floating chat in the tourist shell).
#
# Nothing is required: the assistant always composes a factual answer from
# server-side reads first, and this layer only re-phrases that answer. If you do
# not configure a provider (or the call fails for any reason), the deterministic
# answer is returned unchanged.
#
# Resolution order (all three of a group must be set for it to activate):
#   1. CHAT_AI_*     — assistant-only endpoint
#   2. READINESS_AI_* — reused when CHAT_AI_* is unset, so an existing OpenAI-
#                       compatible setup does not have to be duplicated
#
# Any OpenAI-compatible /chat/completions endpoint works. The key is server-only;
# it is never shipped to the browser, and no prompt text or model output is
# trusted for a decision — see lib/chat-ai.ts.
# CHAT_AI_BASE_URL=https://api.example.com/v1
# CHAT_AI_API_KEY=your-provider-key
# CHAT_AI_MODEL=your-model-id

# Optional — SIH demo sign-in so judges can try the app without registering.
#
# Nothing is required to run the app. Set these only on a demo/deployment build
# to reveal the "Test the app" buttons on the landing page and to arm the
# auto sign-in route. When DEMO_MODE is unset or not "true", both are inert and
# the deployment stays locked to normal login.
#
# The two accounts must exist in Supabase Auth with these exact credentials;
# create and seed them with supabase/seed-demo.js. These are throwaway demo
# logins, not real users, so never reuse a real password here.
# DEMO_MODE=true
# DEMO_TOURIST_EMAIL=visitor@demo.pravvah.app
# DEMO_TOURIST_PASSWORD=change-me-demo-tourist
# DEMO_OPERATOR_EMAIL=officer@demo.pravvah.app
# DEMO_OPERATOR_PASSWORD=change-me-demo-operator
